  "main": "index.js",
  "scripts": {
    "build:api": "openapi-typescript ../openapi.json --output src/ts/bindings.d.ts --empty-objects-unknown",
    "build": "vite build",
    "build:release": "vite build --mode release",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "format": "biome format --write",
    "check": "biome format",
    "test": "node --import ./test/register-ts.js --test \"test/**/*.test.js\"",
    "dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "type": "module",
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^10.0.1",
    "@lit/context": "^1.1.3",
    "@lit/task": "^1.0.1",
    "@types/dom-navigation": "^1.0.4",
    "@types/dom-view-transitions": "^1.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-wc": "^3.0.2",
    "globals": "^17.0.0",
    "js-base64": "^3.7.7",
    "lit": "^3.2.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.4.1",
    "slugify": "^1.6.6",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.11.0",
    "urlpattern-polyfill": "^10.0.0",
    "vite": "^8.3.4"
